---
import { site } from '../config/site';
import { whatsappHref } from '../lib/links';
import Icon from './Icon.astro';

const { hero } = site;
---

<section class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-white" data-section="hero">
  <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 size-96 rounded-full bg-brand-100 blur-3xl"></div>
  <div class="container-page relative grid gap-10 py-14 md:grid-cols-[1.25fr_1fr] md:items-center md:py-24">
    <div>
      <p class="mb-3 inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-sm font-medium text-brand-700 shadow-sm ring-1 ring-brand-100">
        <Icon name="pin" class="size-4" /> {hero.eyebrow}
      </p>
      <h1 class="text-4xl font-extrabold tracking-tight text-brand-900 sm:text-5xl">{hero.heading}</h1>
      <p class="mt-5 max-w-xl text-lg text-slate-600">{hero.sub}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={whatsappHref()} target="_blank" rel="noopener" class="btn bg-whatsapp text-white shadow-sm hover:bg-whatsapp-hover">
          <Icon name="whatsapp" class="size-5" /> {hero.primaryCta}
        </a>
        <a href="#planes" class="btn bg-white text-brand-700 ring-1 ring-brand-200 hover:bg-brand-50">{hero.secondaryCta}</a>
      </div>
      <dl class="mt-10 grid grid-cols-3 gap-2 sm:gap-3">
        {
          hero.stats.map((s) => (
            <div class="flex min-w-0 flex-col rounded-2xl bg-white p-3 shadow-sm ring-1 ring-slate-200 sm:p-4">
              <dt class="text-xs text-slate-600 sm:text-sm">{s.label}</dt>
              <dd class="order-first text-lg font-extrabold whitespace-nowrap text-brand-700 sm:text-2xl">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="rounded-3xl bg-brand-900 p-6 text-white shadow-xl sm:p-8">
      <p class="flex items-center gap-2 text-sm font-semibold tracking-wide text-brand-100 uppercase">
        <Icon name="calendar" class="size-5" /> {hero.checklistTitle}
      </p>
      <ul class="mt-6 space-y-4">
        {
          hero.checklist.map((item) => (
            <li class="flex gap-3">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-accent-500 text-brand-900">
                <Icon name="check" class="size-4" />
              </span>
              <span class="text-brand-50">{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 border-t border-white/15 pt-5 text-sm text-brand-100">
        Facturamos nuestros honorarios con CFDI. Contrato y acuerdo de confidencialidad desde el primer día.
      </p>
    </div>
  </div>
</section>
