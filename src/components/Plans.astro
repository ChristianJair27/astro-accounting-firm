---
import { site } from '../config/site';
import { whatsappHref } from '../lib/links';
import Icon from './Icon.astro';

// Mientras el precio sea 'TODO-CLIENTE' se muestra "A cotizar" (nunca el marcador).
const isPlaceholder = (price: string) => price.includes('TODO');
---

<section id="planes" class="py-16 md:py-24" data-section="plans">
  <div class="container-page">
    <h2 class="section-title">Planes mensuales</h2>
    <p class="mt-3 max-w-2xl text-slate-600">Precio fijo cada mes, sin cobros sorpresa. Elige un punto de partida y lo ajustamos a tu caso.</p>
    <ul class="mt-12 grid gap-8 lg:grid-cols-3 lg:gap-5">
      {
        site.plans.map((p) => (
          <li class:list={['relative flex flex-col rounded-3xl p-6 sm:p-8', p.featured ? 'bg-brand-900 text-white shadow-xl' : 'bg-white ring-1 ring-slate-200']}>
            {p.featured && (
              <p class="absolute -top-3 left-6 rounded-full bg-accent-500 px-3 py-1 text-xs font-bold tracking-wide text-brand-900 uppercase">Más elegido</p>
            )}
            <h3 class:list={['text-xl font-bold', p.featured ? 'text-white' : 'text-brand-900']}>{p.name}</h3>
            <p class:list={['mt-2 text-sm', p.featured ? 'text-brand-100' : 'text-slate-600']}>{p.forWho}</p>
            <p class="mt-6">
              <span class:list={['block text-sm font-medium', p.featured ? 'text-brand-100' : 'text-slate-600']}>Desde</span>
              {isPlaceholder(p.price) ? (
                <span class="text-3xl font-extrabold">A cotizar</span>
              ) : (
                <>
                  <span class="text-4xl font-extrabold">{p.price}</span>
                  <span class:list={['ml-1 text-sm', p.featured ? 'text-brand-100' : 'text-slate-600']}>{p.period} + IVA</span>
                </>
              )}
            </p>
            <ul class:list={['mt-6 flex-1 space-y-3', p.featured ? 'text-brand-50' : 'text-slate-700']}>
              {p.features.map((f) => (
                <li class="flex gap-2">
                  <Icon name="check" class={`mt-0.5 size-5 shrink-0 ${p.featured ? 'text-accent-500' : 'text-brand-600'}`} />
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <a
              href={whatsappHref(`Hola ${site.name}, me interesa el plan ${p.name}. ¿Me pueden dar más información?`)}
              target="_blank"
              rel="noopener"
              class:list={['btn mt-8', p.featured ? 'bg-white text-brand-900 hover:bg-brand-50' : 'bg-brand-700 text-white hover:bg-brand-900']}
            >
              Quiero el plan {p.name}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 max-w-3xl text-sm text-slate-600">{site.plansNote}</p>
  </div>
</section>
