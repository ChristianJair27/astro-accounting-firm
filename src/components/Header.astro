---
import { site } from '../config/site';
import { whatsappHref } from '../lib/links';
import Icon from './Icon.astro';

const nav = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#planes', label: 'Planes' },
  { href: '/#calendario', label: 'Calendario fiscal' },
  { href: '/#proceso', label: 'Cómo empezar' },
  { href: '/#preguntas', label: 'Preguntas' },
  { href: '/#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur" data-section="header">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex min-w-0 items-center gap-2 text-lg font-extrabold tracking-tight text-brand-900">
      <span aria-hidden="true" class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-brand-700 text-white"><Icon name="chart" class="size-5" /></span>
      <span class="truncate">{site.name}</span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex gap-6 text-sm font-medium text-slate-700">
        {nav.map((item) => <li><a class="hover:text-brand-700" href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <a href={whatsappHref()} class="btn hidden min-h-10 bg-whatsapp px-4 py-2 text-sm text-white hover:bg-whatsapp-hover sm:inline-flex" rel="noopener" target="_blank">
        <Icon name="whatsapp" class="size-5" /> WhatsApp
      </a>
      <details class="relative lg:hidden">
        <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-lg text-slate-700 hover:bg-slate-100 [&::-webkit-details-marker]:hidden">
          <Icon name="menu" />
          <span class="sr-only">Abrir menú</span>
        </summary>
        <nav aria-label="Móvil" class="absolute right-0 mt-2 w-60 rounded-xl border border-slate-200 bg-white p-2 shadow-lg">
          <ul>
            {nav.map((item) => <li><a class="block rounded-lg px-3 py-3 text-slate-700 hover:bg-slate-100" href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Cierra el menú móvil al elegir una sección.
  document.querySelectorAll('header details a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
  );
</script>
