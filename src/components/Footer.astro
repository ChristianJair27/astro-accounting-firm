---
import { site } from '../config/site';
import { telHref, mailHref } from '../lib/links';

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 py-10 pb-24 text-sm text-slate-600 md:pb-10" data-section="footer">
  <div class="container-page flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <p>© {year} {site.legalName}. Todos los derechos reservados.</p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      <li><a class="hover:text-brand-700" href={telHref}>{site.phone}</a></li>
      <li><a class="hover:text-brand-700" href={mailHref}>{site.email}</a></li>
      {site.social.map((s) => <li><a class="hover:text-brand-700" href={s.href} rel="noopener" target="_blank">{s.label}</a></li>)}
    </ul>
  </div>
</footer>
