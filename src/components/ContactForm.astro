---
import { site } from '../config/site';
import { whatsappHref } from '../lib/links';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || '/api/lead.php';
const field =
  'mt-1 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-base text-slate-900 placeholder:text-slate-500 focus:border-brand-600 focus:ring-2 focus:ring-brand-200 focus:outline-none';
---

<section id="contacto" class="py-16 md:py-24" data-section="form">
  <div class="container-page max-w-2xl">
    <h2 class="section-title">{site.form.heading}</h2>
    <p class="mt-3 text-slate-600">{site.form.sub}</p>

    <form id="lead-form" action={endpoint} method="post" class="mt-8 grid gap-5 sm:grid-cols-2" novalidate>
      <div class="sm:col-span-1">
        <label for="f-name" class="font-medium text-slate-800">Nombre</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="80" class={field} />
      </div>
      <div class="sm:col-span-1">
        <label for="f-phone" class="font-medium text-slate-800">Teléfono / WhatsApp</label>
        <input id="f-phone" name="phone" type="tel" autocomplete="tel" required inputmode="tel" pattern="[0-9+()\s\-]{8,20}" class={field} />
      </div>
      <div class="sm:col-span-1">
        <label for="f-email" class="font-medium text-slate-800">Correo <span class="font-normal text-slate-600">(opcional)</span></label>
        <input id="f-email" name="email" type="email" autocomplete="email" maxlength="120" class={field} />
      </div>
      <div class="sm:col-span-1">
        <label for="f-service" class="font-medium text-slate-800">Servicio que necesitas</label>
        <select id="f-service" name="service" required class={field}>
          <option value="" disabled selected>Elige un servicio</option>
          {site.form.serviceOptions.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>
      <div class="sm:col-span-1">
        <label for="f-regimen" class="font-medium text-slate-800">Régimen fiscal</label>
        <select id="f-regimen" name="regimen" required class={field}>
          <option value="" disabled selected>Elige tu régimen</option>
          {site.form.regimenOptions.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>
      <div class="sm:col-span-1">
        <label for="f-employees" class="font-medium text-slate-800">Número de empleados</label>
        <select id="f-employees" name="employees" required class={field}>
          <option value="" disabled selected>Elige un rango</option>
          {site.form.employeeOptions.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>
      <div class="sm:col-span-2">
        <label for="f-message" class="font-medium text-slate-800">Cuéntanos tu caso <span class="font-normal text-slate-600">(opcional)</span></label>
        <textarea id="f-message" name="message" rows="4" maxlength="1500" class={field}></textarea>
      </div>

      <!-- Anti-spam: honeypot (humanos no lo ven) + tiempo mínimo de llenado. -->
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label for="f-website">No llenar este campo</label>
        <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="ts" value="" />
      <input type="hidden" name="source" value="landing_form" />

      <div class="sm:col-span-2">
        <button type="submit" class="btn w-full bg-brand-600 text-white hover:bg-brand-700 disabled:opacity-60 sm:w-auto">Enviar solicitud</button>
        <p class="mt-3 text-sm text-slate-600">Usamos tus datos solo para responder tu solicitud. No compartas contraseñas ni tu e.firma por este medio.</p>
        <p id="form-status" role="status" aria-live="polite" class="mt-4 hidden rounded-xl p-4 text-sm"></p>
      </div>
    </form>
  </div>
</section>

<script define:vars={{ waFallback: whatsappHref() }}>
  window.__waFallback = waFallback;
</script>

<script>
  import { track, trackAdsLead } from '../lib/analytics';

  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  function show(kind: 'ok' | 'error', html: string) {
    if (!status) return;
    status.className = `mt-4 rounded-xl p-4 text-sm ${kind === 'ok' ? 'bg-green-50 text-green-900' : 'bg-red-50 text-red-900'}`;
    status.innerHTML = html;
  }

  if (form) {
    const ts = form.elements.namedItem('ts') as HTMLInputElement;
    ts.value = String(Date.now());

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      button.disabled = true;
      const data = new FormData(form);
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const json = (await res.json().catch(() => ({}))) as { ok?: boolean };
        if (!res.ok || !json.ok) throw new Error(String(res.status));
        track('generate_lead', {
          service: String(data.get('service') ?? ''),
          regimen: String(data.get('regimen') ?? ''),
          employees: String(data.get('employees') ?? ''),
          source: String(data.get('source') ?? ''),
        });
        trackAdsLead();
        form.reset();
        show('ok', '¡Gracias! Recibimos tu solicitud y te contactaremos muy pronto.');
      } catch {
        const wa = (window as unknown as { __waFallback: string }).__waFallback;
        show('error', `No pudimos enviar el formulario. Inténtalo de nuevo o <a class="font-semibold underline" href="${wa}" target="_blank" rel="noopener">escríbenos por WhatsApp</a>.`);
      } finally {
        button.disabled = false;
        ts.value = String(Date.now());
      }
    });
  }
</script>
