---
import { site } from '../config/site';
---

<section id="proceso" class="py-16 md:py-24" data-section="process">
  <div class="container-page">
    <h2 class="section-title">Cómo empezar en 4 pasos</h2>
    <p class="mt-3 max-w-2xl text-slate-600">Cambiarte de contador es más sencillo de lo que parece. Nosotros coordinamos la transición.</p>
    <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        site.steps.map((s, i) => (
          <li class="rounded-2xl border border-slate-200 bg-white p-6">
            <span aria-hidden="true" class="inline-flex size-10 items-center justify-center rounded-full bg-brand-700 text-lg font-extrabold text-white">
              {i + 1}
            </span>
            <h3 class="mt-4 text-lg font-bold text-brand-900">
              <span class="sr-only">Paso {i + 1}: </span>
              {s.title}
            </h3>
            <p class="mt-2 text-slate-600">{s.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
