---
import { site } from '../config/site';
import Icon from './Icon.astro';
---

<section id="a-quien-atendemos" class="bg-slate-50 py-16 md:py-24" data-section="audiences">
  <div class="container-page">
    <h2 class="section-title">A quién atendemos</h2>
    <p class="mt-3 max-w-2xl text-slate-600">Conocemos las reglas de cada régimen y te decimos cuál te conviene según tus ingresos y actividad.</p>
    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {
        site.audiences.map((a) => (
          <li class="flex flex-col rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <span class="inline-flex size-12 items-center justify-center rounded-xl bg-accent-50 text-accent-800">
              <Icon name={a.icon} />
            </span>
            <h3 class="mt-4 text-xl font-bold text-brand-900">{a.title}</h3>
            <p class="mt-2 text-slate-600">{a.description}</p>
            <ul class="mt-5 space-y-2 border-t border-slate-200 pt-5 text-slate-700">
              {a.points.map((p) => (
                <li class="flex gap-2">
                  <Icon name="check" class="mt-0.5 size-5 shrink-0 text-brand-600" />
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
