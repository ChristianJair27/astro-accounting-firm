---
import { site } from '../config/site';
import Icon from './Icon.astro';
---

<section id="servicios" class="py-16 md:py-24" data-section="services">
  <div class="container-page">
    <h2 class="section-title">Servicios contables y fiscales</h2>
    <p class="mt-3 max-w-2xl text-slate-600">
      Un solo despacho para todo lo que te pide el SAT, el IMSS y tu negocio. Contadores titulados y precio mensual fijo.
    </p>
    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        site.services.map((s) => (
          <li class="rounded-2xl border border-slate-200 bg-white p-6 transition-shadow hover:shadow-md">
            <span class="inline-flex size-12 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
              <Icon name={s.icon} />
            </span>
            <h3 class="mt-4 text-lg font-bold text-brand-900">{s.title}</h3>
            <p class="mt-2 text-slate-600">{s.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
