---
import { site } from '../config/site';
import Icon from './Icon.astro';

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((p) => p[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();

// Si queda algún testimonio de ejemplo, se avisa en pantalla (honestidad en demos).
const hasExamples = site.testimonials.some((t) => t.example);
---

<section id="opiniones" class="bg-slate-50 py-16 md:py-24" data-section="testimonials">
  <div class="container-page">
    <h2 class="section-title">Lo que dicen nuestros clientes</h2>
    {hasExamples && <p class="mt-3 text-sm text-slate-600" data-testid="example-note">Testimonios de ejemplo (sitio demo).</p>}
    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {
        site.testimonials.map((t) => (
          <li>
            <figure class="flex h-full flex-col rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
              <div class="flex gap-0.5 text-accent-500" role="img" aria-label="5 de 5 estrellas">
                {[1, 2, 3, 4, 5].map(() => <Icon name="star" class="size-5" />)}
              </div>
              <blockquote class="mt-4 flex-1 text-slate-700">
                <p>“{t.quote}”</p>
              </blockquote>
              <figcaption class="mt-6 flex items-center gap-3">
                <span aria-hidden="true" class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-700">
                  {initials(t.name)}
                </span>
                <span>
                  <span class="block font-semibold text-brand-900">{t.name}</span>
                  <span class="block text-sm text-slate-600">{t.role}</span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
